# =========================
# General Environment
# =========================
# Environment profile name (e.g., local_dev_compose, staging, production)
TEST="local_dev_compose"


# =========================
# Database Connection
# =========================
# PostgreSQL connection string
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=your_db_name;Username=your_db_user;Password=your_db_password;SSL Mode=Require;Trust Server Certificate=true;Include Error Detail=true"

# Redis connection string
ConnectionStrings__Redis="localhost:6379,abortConnect=false"

# Public API URL for the frontend to talk to the backend
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:3001


# =========================
# JWT (Authentication Tokens)
# =========================
# Secret key for signing JWT tokens (must be 32+ characters)
JWT__SecretKey="your_super_secret_jwt_key_min_32_chars_here!!"

# Token issuer identifier (usually backend service name)
JWT__Issuer="YourApp.Api"

# Token audience identifier (usually frontend client name)
JWT__Audience="YourApp.Client"

# Access token expiry time (in minutes)
JWT__ExpiryMinutes=120

# Refresh token expiry time (in days)
JWT__RefreshTokenExpiryDays=7


# =========================
# OAuth Configuration - Google
# =========================
# Google OAuth 2.0 Client ID
OAuth__Google__ClientId="your_google_client_id.apps.googleusercontent.com"

# Google OAuth 2.0 Client Secret
OAuth__Google__ClientSecret="your_google_client_secret"

# Callback URL where Google will redirect after login
OAuth__Google__RedirectUri="http://localhost:5000/auth/google/callback"


# =========================
# OAuth Configuration - GitHub
# =========================
# GitHub OAuth 2.0 Client ID
OAuth__GitHub__ClientId="your_github_client_id"

# GitHub OAuth 2.0 Client Secret
OAuth__GitHub__ClientSecret="your_github_client_secret"

# Callback URL for GitHub OAuth redirect
OAuth__GitHub__RedirectUri="http://localhost:5000/auth/github/callback"


# =========================
# SMTP Configuration
# =========================
Email__Smtp__Host="smtp.yourmailprovider.com"
Email__Smtp__Port=587
Email__Smtp__EnableSsl=false
Email__Smtp__Username="mail@yourdomain.com"
Email__Smtp__Password="your_smtp_password"
Email__Smtp__FromEmail="mail@yourdomain.com"
Email__Smtp__FromName="Your App Name"
Email__Smtp__Timeout=10000


# =========================
# Logging
# =========================
# Path for Serilog log files
Serilog__WriteTo__1__Args__path=/app/logs/dotnet/your-app-.log


# =========================
# Frontend Configuration
# =========================
# Base URL for the frontend application
Frontend__BaseUrl="http://localhost:3001"


# =========================
# Bootleg Streaming
# =========================
BootlegStreaming__SigningKey="your_signing_key_min_32_chars_here!!"
BootlegStreaming__TokenTtlMinutes=60


# =========================
# Hangfire Configuration
# =========================
Hangfire__DashboardAuth__Username="admin"
Hangfire__DashboardAuth__Password="your_hangfire_dashboard_password"
